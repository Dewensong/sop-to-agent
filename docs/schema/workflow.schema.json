{
  "$ref": "#/definitions/WorkflowSpec",
  "definitions": {
    "WorkflowSpec": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "sopId": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "sopNodeId": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "agent",
                  "tool",
                  "human_review",
                  "manual"
                ]
              },
              "prompt": {
                "type": "string"
              },
              "toolName": {
                "type": "string"
              },
              "inputSchema": {
                "type": "object",
                "additionalProperties": {}
              },
              "outputSchema": {
                "type": "object",
                "additionalProperties": {}
              },
              "automationScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "feasibilityScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "riskScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "rationale": {
                "type": "string"
              },
              "adapterTargets": {
                "type": "object",
                "properties": {
                  "langGraph": {
                    "type": "string",
                    "enum": [
                      "ready",
                      "draft",
                      "manual"
                    ]
                  },
                  "n8n": {
                    "$ref": "#/definitions/WorkflowSpec/properties/nodes/items/properties/adapterTargets/properties/langGraph"
                  },
                  "dify": {
                    "$ref": "#/definitions/WorkflowSpec/properties/nodes/items/properties/adapterTargets/properties/langGraph"
                  }
                },
                "required": [
                  "langGraph",
                  "n8n",
                  "dify"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "sopNodeId",
              "title",
              "mode",
              "automationScore",
              "feasibilityScore",
              "riskScore",
              "confidence",
              "rationale",
              "adapterTargets"
            ],
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "condition": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        },
        "humanGates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "nodeId": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "reviewer": {
                "type": "string"
              },
              "requiredInputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "nodeId",
              "title",
              "reason",
              "reviewer",
              "requiredInputs"
            ],
            "additionalProperties": false
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "targetNodes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "name",
              "purpose",
              "targetNodes"
            ],
            "additionalProperties": false
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "responsibility": {
                "type": "string"
              },
              "assignedNodeIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "name",
              "responsibility",
              "assignedNodeIds"
            ],
            "additionalProperties": false
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "description",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "exportTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "markdown",
              "json",
              "mermaid",
              "langgraph_draft"
            ]
          }
        }
      },
      "required": [
        "id",
        "sopId",
        "nodes",
        "edges",
        "humanGates",
        "tools",
        "agents",
        "metrics",
        "exportTargets"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
