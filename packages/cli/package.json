{
  "name": "@sopilot/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "sopilot": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sopilot": "tsx src/index.ts",
    "generate-all": "tsx src/index.ts generate-all --out ../../examples/generated"
  },
  "dependencies": {
    "@sopilot/core": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5"
  }
}
